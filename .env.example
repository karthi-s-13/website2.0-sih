# Copy to .env and adjust for your environment.
# Never commit a real .env file.

# ---- App ----
APP_NAME=project-monitoring-ai
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/project_monitoring

# ---- Cache ----
REDIS_URL=redis://localhost:6379/0

# ---- Vector DB (Phase 7+) ----
VECTOR_DB_URL=http://localhost:6333

# ---- Object Storage (MinIO/S3-compatible) ----
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=project-monitoring

# ---- Security ----
SECRET_KEY=change-me-in-env
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- CORS ----
# Add every origin the frontend is actually served from (e.g. if you override
# FRONTEND_PORT above, add that port here too).
CORS_ORIGINS=["http://localhost:3000"]

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=true

# ---- LLM (Gemini) — Phase 6 Project History Agent narrative synthesis only ----
# Used only to write the human-readable "current_state" summary from
# already-computed, deterministic evidence. Never used to compute facts,
# trends, or predictions. Leave blank to disable — the agent falls back to a
# deterministic template summary.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- Web Search (Tavily) — Phase 8 Web Intelligence Agent ----
# Used to find external implementation signals (news, government notices,
# court cases, tender/contractor disputes, etc.) about a project. Leave
# blank to disable — the agent falls back to reporting web evidence as
# unavailable instead of fabricating results.
TAVILY_API_KEY=

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Docker Compose host port overrides (optional) ----
# Uncomment and change if the default ports are already in use on your machine.
# API_PORT=8000
# FRONTEND_PORT=3000
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# ---- Docker Compose Postgres password override (optional) ----
# Only affects a freshly created postgres_data volume (Postgres sets the
# password on first init). To change the password on an existing volume,
# run `ALTER USER postgres WITH PASSWORD '...';` against the running
# container instead, then update DATABASE_URL above to match.
# POSTGRES_PASSWORD=postgres
